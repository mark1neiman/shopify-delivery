// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model PickupConfig {
  id        String   @id @default(cuid())
  shop      String   @unique
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceSettings {
  id             String   @id @default(cuid())
  shop           String   @unique
  triggerTopic   String   @default("orders/paid")
  enabled        Boolean  @default(false)
  defaultLocale  String   @default("en")
  fromName       String?
  fromEmail      String?
  replyToEmail   String?
  emailSubjectEn String?
  emailSubjectEt String?
  emailBodyEn    String?
  emailBodyEt    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InvoiceTemplate {
  id              String   @id @default(cuid())
  shop            String
  locale          String
  name            String
  description     String?
  activeVersionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop, locale])
  @@unique([shop, locale, name])
}

model InvoiceTemplateVersion {
  id          String   @id @default(cuid())
  templateId  String
  version     Int
  isPublished Boolean  @default(false)
  html        String
  css         String?
  tokensJson  String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([templateId, isPublished])
  @@unique([templateId, version])
}

model InvoiceLocaleMapping {
  id             String   @id @default(cuid())
  shop           String
  storefrontLang String
  invoiceLocale  String
  templateId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, storefrontLang])
  @@index([shop, invoiceLocale])
}

model InvoiceDocument {
  id             String   @id @default(cuid())
  shop           String
  orderId        String
  orderName      String?
  orderEmail     String?
  locale         String
  status         String   @default("generated")
  pdfStorageType String?
  pdfStorageKey  String?
  pdfUrl         String?
  checksum       String?
  sentAt         DateTime?
  sentToEmail    String?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shop, createdAt])
  @@unique([shop, orderId, locale])
}

model InvoiceJob {
  id           String   @id @default(cuid())
  shop         String
  triggerTopic String
  orderId      String
  orderName    String?
  orderEmail   String?
  orderLocale  String?
  status       String   @default("queued")
  attempts     Int      @default(0)
  maxAttempts  Int      @default(5)
  lastError    String?
  payloadJson  String?
  lockedAt     DateTime?
  lockOwner    String?
  runAfter     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shop, status, runAfter])
  @@index([status, createdAt])
  @@unique([shop, triggerTopic, orderId])
}
